{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "deploy/desktop-download/Dockerfile",
    "watchPatterns": [
      "/apps/desktop/**",
      "/deploy/desktop-download/**",
      "/deploy/native-version.cjs",
      "/package-lock.json",
      "/package.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 900,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
