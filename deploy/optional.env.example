# Adicione somente os blocos que for utilizar ao .env da API.
# SMTP: necessário para confirmação de e-mail e recuperação de senha.
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_TLS=true

# Materiais PDF/TXT: bucket privado S3/MinIO.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# IA: exige materiais/storage configurados.
AI_ENABLED=true
AI_BASE_URL=https://api.openai.com/v1
# Modelo definido no codigo: gpt-5.6-sol
OPENAI_API_KEY=
AI_WEB_SEARCH_ENABLED=false

# Chamadas: LiveKit com TLS. O cliente Web habilita microfone, câmera e compartilhamento de tela.
VOICE_ENABLED=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Somente para adicionar domínios próprios ou preview ao WebSocket.
# Use origens exatas separadas por vírgula, incluindo o APP_URL.
# CORS_ORIGINS=https://enturma-flax.vercel.app,https://preview-exato.vercel.app

# Push Android (Firebase Cloud Messaging)
# JSON da service account autorizado para FCM HTTP v1, codificado integralmente em Base64.
FCM_SERVICE_ACCOUNT_BASE64=

# Enturma Social: habilitar somente após validar migrations, runtime e bucket privado.
SOCIAL_ENABLED=false
SOCIAL_MEDIA_ENABLED=false
SOCIAL_STORAGE_ENDPOINT=
SOCIAL_STORAGE_BUCKET=enturma-social
SOCIAL_STORAGE_REGION=auto
SOCIAL_STORAGE_ACCESS_KEY=
SOCIAL_STORAGE_SECRET_KEY=
SOCIAL_FFMPEG=ffmpeg
SOCIAL_FFPROBE=ffprobe
