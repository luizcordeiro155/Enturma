{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "dockerfilePath": "deploy/android-download/Dockerfile",
    "watchPatterns": [
      "/apps/mobile/**",
      "/deploy/android-download/**",
      "/deploy/native-version.cjs",
      "/packages/contracts/**",
      "/packages/design-tokens/**",
      "/package-lock.json",
      "/package.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 1200,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
