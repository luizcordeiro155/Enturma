# API SquareCloud. Preencha sem aspas. A aplicação lê este arquivo diretamente.
# Railway: use DATABASE_PUBLIC_URL (postgresql://usuario:senha@host-publico:porta/banco).
DATABASE_URL=
# Opcionais se a URL acima ja incluir usuario e senha; obrigatorios para URL JDBC.
DATABASE_USERNAME=
DATABASE_PASSWORD=

APP_URL=https://enturma-flax.vercel.app
# Gere uma chave aleatória de 32+ caracteres; use o mesmo valor na Vercel.
BFF_PROXY_SECRET=

# E-mail transacional (confirmação de conta e recuperação de senha)
# Configure estes valores somente no backend/SquareCloud.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_TLS=true

# Enturma AI / OpenAI
# Padrão: gpt-4.1-mini. AI_MODEL é opcional para escolher outro modelo compatível.
OPENAI_API_KEY=
# Ativa o modo Pesquisa, que pode consultar a web e retornar URLs citadas.
AI_WEB_SEARCH_ENABLED=false
# Normalmente não altere; mantido para compatibilidade/proxy OpenAI-compatible.
AI_BASE_URL=https://api.openai.com/v1

# Chamadas de voz, câmera e compartilhamento de tela (LiveKit)
VOICE_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Materiais privados da sala (S3/R2 compatível)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Push Android (Firebase Cloud Messaging)
# JSON da service account autorizado para FCM HTTP v1, codificado integralmente em Base64.
FCM_SERVICE_ACCOUNT_BASE64=
