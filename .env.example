# API SquareCloud. Preencha sem aspas. A aplicação lê este arquivo diretamente.
# Railway: use DATABASE_PUBLIC_URL (postgresql://usuario:senha@host-publico:porta/banco).
DATABASE_URL=
# Opcionais se a URL acima ja incluir usuario e senha; obrigatorios para URL JDBC.
DATABASE_USERNAME=
DATABASE_PASSWORD=
APP_URL=https://enturma-flax.vercel.app
# Gere uma chave aleatória de 32+ caracteres; use o mesmo valor na Vercel.
BFF_PROXY_SECRET=
