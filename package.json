{
  "name": "enturma",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @enturma/web",
    "dev:mobile": "npm run start -w @enturma/mobile",
    "build": "npm run build -w @enturma/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "expo-router": "^55.0.18",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "react-native-reanimated": "4.2.1",
    "react-native-worklets": "0.7.4"
  }
}
