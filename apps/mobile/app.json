{
  "expo": {
    "name": "Enturma",
    "slug": "enturma",
    "scheme": "enturma",
    "version": "0.3.22",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.enturma.app",
      "buildNumber": "23",
      "infoPlist": {
        "NSCameraUsageDescription": "Use sua câmera nas chamadas de estudo.",
        "NSMicrophoneUsageDescription": "Converse por voz com sua turma.",
        "NSPhotoLibraryUsageDescription": "Escolha imagens para compartilhar ou personalizar seu perfil."
      }
    },
    "android": {
      "package": "br.com.enturma.app",
      "versionCode": 25,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha imagens para estudar em companhia."
        }
      ],
      "expo-document-picker"
    ],
    "icon": "./assets/icon.png"
  }
}
