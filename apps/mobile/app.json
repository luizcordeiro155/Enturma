{
  "expo": {
    "name": "Enturma",
    "slug": "enturma",
    "scheme": "enturma",
    "version": "0.3.4",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.enturma.app",
      "buildNumber": "5",
      "infoPlist": {
        "NSCameraUsageDescription": "Use sua câmera nas chamadas de estudo.",
        "NSMicrophoneUsageDescription": "Converse por voz com sua turma.",
        "NSPhotoLibraryUsageDescription": "Escolha imagens para compartilhar ou personalizar seu perfil."
      }
    },
    "android": {
      "package": "br.com.enturma.app",
      "versionCode": 7,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#183f36"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha imagens para estudar em companhia."
        }
      ],
      "expo-document-picker"
    ],
    "icon": "./assets/icon.png"
  }
}
